<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- micro (exécution renforcée « hardened runtime », exigée pour la notarisation) -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Deno (runtime JavaScript de yt-dlp) compile du JavaScript à la volée -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- yt-dlp (PyInstaller) charge ses bibliothèques Python décompressées au lancement -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
