# Copiez ce fichier en « .env » sur le serveur, puis remplissez-le.

# Jeton du tunnel Cloudflare (Zero Trust › Networks › Tunnels › votre tunnel › « docker run … --token XXXX »)
CLOUDFLARE_TUNNEL_TOKEN=

# Modèle Whisper pour les paroles par IA : base | small | large-v3-turbo-q5_0 | none
WHISPER_MODEL_NAME=small
WHISPER_THREADS=4

# Nouvelles analyses autorisées par visiteur et par heure
RATE_LIMIT_PER_HOUR=30

# Seulement si YouTube bloque encore le serveur : fichier de cookies exporté depuis un navigateur
# (placez-le dans le dossier secrets/ à côté de ce fichier)
# YTDLP_COOKIES=/secrets/cookies.txt
