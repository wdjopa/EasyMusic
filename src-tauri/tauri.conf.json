{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnjoySing",
  "version": "0.1.0",
  "identifier": "me.resub.enjoysing",
  "build": {
    "beforeDevCommand": "npm run tauri:web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run tauri:web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EnjoySing",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Accords, paroles et partition d'une chanson YouTube, transposés pour votre voix",
    "longDescription": "EnjoySing trouve les accords, les paroles et la partition d'une chanson YouTube et les transpose pour votre voix. L'audio est téléchargé depuis votre ordinateur avec yt-dlp.",
    "copyright": "EnjoySing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
