{
  "name": "easymusic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"npm:server:dev\"",
    "server:dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && node scripts/zip-extension.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "whisper:setup": "bash scripts/whisper-setup.sh",
    "ext:zip": "node scripts/zip-extension.mjs",
    "tauri": "tauri",
    "tauri:sidecars": "node scripts/fetch-sidecars.mjs",
    "tauri:web:dev": "vite --mode tauri --port 1420 --strictPort",
    "tauri:web:build": "tsc --noEmit && vite build --mode tauri",
    "tauri:dev": "node scripts/fetch-sidecars.mjs && tauri dev",
    "tauri:build": "node scripts/fetch-sidecars.mjs && tauri build",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "abcjs": "^6.4.4",
    "bgutils-js": "^4.0.3",
    "youtubei.js": "^18.3.0"
  }
}
